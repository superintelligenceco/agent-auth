{
  "name": "agent-auth",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:22-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "postCreateCommand": "npm ci && curl -fsSL https://bun.sh/install | bash",
  "forwardPorts": [8787],
  "portsAttributes": {
    "8787": { "label": "agent-auth server" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "biomejs.biome",
        "vitest.explorer",
        "github.vscode-github-actions",
        "redhat.vscode-yaml"
      ]
    }
  }
}
